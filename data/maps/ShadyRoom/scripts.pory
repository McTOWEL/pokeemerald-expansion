mapscripts ShadyRoom_MapScripts {}

script ShadyRoom_EventScript_Gentleman {
    lock
    faceplayer

    buffernumberstring(STR_VAR_1, VAR_TOKEN_BALANCE)
    setvar(VAR_RESULT, FALSE)
    msgbox(ShadyRoom_Text_Gentleman_Greeting)

    while (var(VAR_RESULT) != MULTI_B_PRESSED) {
        call(ShadyRoom_EventScript_Gentleman_Menu)
    }

    closemessage
    release
}

script ShadyRoom_EventScript_Gentleman_Menu {
    setvar(VAR_0x8004, SCROLL_MULTI_GENTLEMAN_SERVICES)

    message(ShadyRoom_Text_Gentleman_Menu)
    waitmessage

    special(ShowScrollableMultichoice)

    switch (var(VAR_RESULT)) {
        case 0:
            call(ShadyRoom_EventScript_Gentleman_ChangeNature)

        case 1:
            call(ShadyRoom_EventScript_Gentleman_HiddenAbility)

        case 2:
            call(ShadyRoom_EventScript_Gentleman_RegularAbility)

        case 3:
            call(ShadyRoom_EventScript_Gentleman_MaxIV)

        case 4:
            setvar(VAR_RESULT, MULTI_B_PRESSED)

        case MULTI_B_PRESSED:
            return
    }
}

script ShadyRoom_EventScript_Gentleman_SelectPokemon {
    special(ChoosePartyMon)

    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        setvar(VAR_SERVICE_SELECTION_OK, FALSE)
        return
    }

    special(IsSelectedMonEgg)

    if (var(VAR_RESULT) == TRUE) {
        msgbox(ShadyRoom_Text_Gentleman_CantSelectEgg)
        setvar(VAR_SERVICE_SELECTION_OK, FALSE)
        return
    }

    setvar(VAR_SERVICE_SELECTION_OK, TRUE)
    return
}

script ShadyRoom_EventScript_Gentleman_CheckTokens {
    if (var(VAR_TOKEN_BALANCE) == 0) {
        msgbox(ShadyRoom_Text_Gentleman_NoTokens)
        setvar(VAR_RESULT, MULTI_B_PRESSED)
        return
    }

    if (var(VAR_TOKEN_BALANCE) < VAR_SERVICE_COST) {
        msgbox(ShadyRoom_Text_Gentleman_InsufficientTokens)
        setvar(VAR_SERVICE_SELECTION_OK, FALSE)
        return
    }

    setvar(VAR_SERVICE_SELECTION_OK, TRUE)
    return
}

script ShadyRoom_EventScript_Gentleman_ChangeNature {
    setvar(VAR_SERVICE_COST, 2)
    call(ShadyRoom_EventScript_Gentleman_CheckTokens)
    if (var(VAR_SERVICE_SELECTION_OK) == FALSE || var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }

    msgbox(ShadyRoom_Text_Gentleman_NatureCost, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    call(ShadyRoom_EventScript_Gentleman_SelectPokemon)
    if (var(VAR_SERVICE_SELECTION_OK) == FALSE) {
        return
    }

    copyvar(VAR_0x8006, VAR_0x8004)
	setvar(VAR_0x8004, SCROLL_MULTI_NATURE_PICKER)
	special(ShowScrollableMultichoice)

    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }

    copyvar(VAR_0x8004, VAR_0x8006)
    copyvar(VAR_0x8005, VAR_RESULT)

    special(IsNatureSameAsCurrent)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(ShadyRoom_Text_Gentleman_SameNature)
        return
    }
    
    copyvar(VAR_RESULT, VAR_0x8005)
    special(SetHiddenNature)
    subvar(VAR_TOKEN_BALANCE, VAR_SERVICE_COST)
    msgbox(ShadyRoom_Text_Gentleman_NatureChanged)
    setvar(VAR_RESULT, MULTI_B_PRESSED)
}

script ShadyRoom_EventScript_Gentleman_HiddenAbility {
    setvar(VAR_SERVICE_COST, 4)
    call(ShadyRoom_EventScript_Gentleman_CheckTokens)
    if (var(VAR_SERVICE_SELECTION_OK) == FALSE || var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }

    msgbox(ShadyRoom_Text_Gentleman_HiddenAbilityCost, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    call(ShadyRoom_EventScript_Gentleman_SelectPokemon)
    if (var(VAR_SERVICE_SELECTION_OK) == FALSE) {
        return
    }

    special(MonHasHiddenAbility)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(ShadyRoom_Text_Gentleman_AlreadyHiddenAbility)
        return
    }

    msgbox(ShadyRoom_Text_Gentleman_HiddenAbilityConfirm, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    setvar(VAR_0x8005, 2)
    special(SetAbilitySlot)

    subvar(VAR_TOKEN_BALANCE, VAR_SERVICE_COST)
    msgbox(ShadyRoom_Text_Gentleman_HAApplied)
    setvar(VAR_RESULT, MULTI_B_PRESSED)
}

script ShadyRoom_EventScript_Gentleman_RegularAbility {
    msgbox(ShadyRoom_Text_Gentleman_RestoreAbilityOffer, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    call(ShadyRoom_EventScript_Gentleman_SelectPokemon)
    if (var(VAR_SERVICE_SELECTION_OK) == FALSE) {
        return
    }

    special(MonHasHiddenAbility)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(ShadyRoom_Text_Gentleman_AlreadyRegularAbility)
        return
    }

    msgbox(ShadyRoom_Text_Gentleman_RestoreAbilityConfirm, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    setvar(VAR_0x8005, 0)
    special(SetAbilitySlot)

    msgbox(ShadyRoom_Text_Gentleman_AbilityRestored)
    setvar(VAR_RESULT, MULTI_B_PRESSED)
}

script ShadyRoom_EventScript_Gentleman_MaxIV {
    setvar(VAR_SERVICE_COST, 2)
    call(ShadyRoom_EventScript_Gentleman_CheckTokens)
    if (var(VAR_SERVICE_SELECTION_OK) == FALSE || var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }

    msgbox(ShadyRoom_Text_Gentleman_IVCost, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    call(ShadyRoom_EventScript_Gentleman_SelectPokemon)
    if (var(VAR_SERVICE_SELECTION_OK) == FALSE) {
        return
    }

    msgbox("Which stat would you like to train?")
    copyvar(VAR_0x8006, VAR_0x8004) # Save Party Index in 0x8006

    setvar(VAR_0x8004, SCROLL_MULTI_IV_PICKER)
    special(ShowScrollableMultichoice)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }

    copyvar(VAR_0x8005, VAR_RESULT)

    special(BufferAndCheckIV)

    if (var(VAR_RESULT) == FALSE) {
        msgbox(ShadyRoom_Text_Gentleman_IVAlreadyMax)
        return
    }

    msgbox(ShadyRoom_Text_Gentleman_IVConfirm, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    special(ApplyIVMax)

    subvar(VAR_TOKEN_BALANCE, VAR_SERVICE_COST)
    msgbox(ShadyRoom_Text_Gentleman_IVMaxed)
    setvar(VAR_RESULT, MULTI_B_PRESSED)
}

script ShadyRoom_EventScript_Assistant {
    lock
    faceplayer

    setvar(VAR_RESULT, FALSE)
    msgbox(ShadyRoom_Text_Assistant_Greeting)

    while (var(VAR_RESULT) != MULTI_B_PRESSED) {
        call(ShadyRoom_EventScript_Assistant_Menu)
    }

    closemessage
    release
}

script ShadyRoom_EventScript_Assistant_Menu {
    setvar(VAR_0x8004, SCROLL_MULTI_ASSISTANT_SERVICES)

    message(ShadyRoom_Text_Assistant_Menu)
    waitmessage

    special(ShowScrollableMultichoice)

    switch (var(VAR_RESULT)) {
        case 0:
            call(ShadyRoom_EventScript_Assistant_SetStatus)

        case 1:
            call(ShadyRoom_EventScript_Assistant_SetDamage)

        case 2:
            setvar(VAR_RESULT, MULTI_B_PRESSED)

        case MULTI_B_PRESSED:
            return
    }
}

script ShadyRoom_EventScript_Assistant_SetStatus {
    msgbox(ShadyRoom_Text_Assistant_StatusFlavor, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    call(ShadyRoom_EventScript_Gentleman_SelectPokemon)
    if (var(VAR_SERVICE_SELECTION_OK) == FALSE) {
        return
    }

    msgbox("Which status would you like to inflict?")
    copyvar(VAR_0x8006, VAR_0x8004) # Save Party Index in 0x8006

    setvar(VAR_0x8004, SCROLL_MULTI_STATUS_PICKER)
    special(ShowScrollableMultichoice)

    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }

    copyvar(VAR_0x8005, VAR_RESULT)

    special(ApplyStatus)

    if (var(VAR_0x8005) == 6) {
        msgbox(ShadyRoom_Text_Assistant_StatusCured)
    }
    else {
        msgbox(ShadyRoom_Text_Assistant_StatusInflicted)
    }
    setvar(VAR_RESULT, MULTI_B_PRESSED)
}

script ShadyRoom_EventScript_Assistant_SetDamage {
    msgbox(ShadyRoom_Text_Assistant_DamageFlavor, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    call(ShadyRoom_EventScript_Gentleman_SelectPokemon)
    if (var(VAR_SERVICE_SELECTION_OK) == FALSE) {
        return
    }

    copyvar(VAR_0x8006, VAR_0x8004) # Save Party Index in 0x8006

    setvar(VAR_0x8004, SCROLL_MULTI_DAMAGE_PICKER)
    special(ShowScrollableMultichoice)

    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }

    copyvar(VAR_0x8005, VAR_RESULT)


    if (var(VAR_0x8005) == 7) {
        msgbox("Custom HP %\nTens digit (0-9):")

        setvar(VAR_0x8004, SCROLL_MULTI_NUMBER_PICKER)
        special(ShowScrollableMultichoice)

        if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
        }

        copyvar(VAR_0x8007, VAR_RESULT)

        msgbox("Custom HP %\nOnes digit (0-9):")

        setvar(VAR_0x8004, SCROLL_MULTI_NUMBER_PICKER)
        special(ShowScrollableMultichoice)

        if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
        }

        copyvar(VAR_0x8008, VAR_RESULT)
    }

    special(SetPokemonToPercentHP)
    msgbox(ShadyRoom_Text_Assistant_DamageApplied)
    setvar(VAR_RESULT, MULTI_B_PRESSED)
}

script ShadyRoom_EventScript_Merchant {
    lock
    faceplayer

    setvar(VAR_RESULT, FALSE)
    msgbox(ShadyRoom_Text_Merchant_Greeting)

    while (var(VAR_RESULT) != MULTI_B_PRESSED) {
        call(ShadyRoom_EventScript_Merchant_Menu)
    }

    closemessage
    release
}

script ShadyRoom_EventScript_Merchant_Menu {
    buffernumberstring(STR_VAR_3, VAR_TOKEN_BALANCE)
    msgbox(ShadyRoom_Text_Merchant_Menu)
    waitmessage

    special(MerchantMenu)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }

    copyvar(VAR_0x8004, VAR_RESULT)
    special(GetMerchantItemInfo)

    msgbox(ShadyRoom_Text_Merchant_PurchaseConfirm, MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        return
    }

    special(TryPurchaseMerchantItem)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(ShadyRoom_Text_Merchant_InsufficientFunds)
        return
    }

    msgbox(ShadyRoom_Text_Merchant_PurchaseCommit)
}

script ShadyRoom_EventScript_Abra {
    lock
    faceplayer
    addvar(VAR_TOKEN_BALANCE, 1)
    msgbox(ShadyRoom_Text_Placeholder)
    release
}

text ShadyRoom_Text_Placeholder {
    "This feature hasn't been implemented yet."
}

text ShadyRoom_Text_Gentleman_Greeting {
    "GENTLEMAN: Keep your voice down...\n"
    "Let's see. You have {STR_VAR_1} unit(s) of credit.\p"
    "I specialize in... off-the-record\n"
    "modifications. What do you need?"
}

text ShadyRoom_Text_Gentleman_Menu {
    "What can I do for you?\n"
    "You have {STR_VAR_1} unit(s) of credit."
}

text ShadyRoom_Text_Gentleman_CantSelectEgg {
    "An Egg? Let's wait until it hatches\n"
	"before we start rewriting its DNA."
}

text ShadyRoom_Text_Gentleman_InsufficientTokens {
	"Look, I like you, but I don't work\n"
    "pro bono. You're short on credit.\p"
    "Come back when you can afford my rates."
}

text ShadyRoom_Text_Gentleman_NoTokens {
    "Come now, let's not waste time.\n"
    "Your line of credit is tapped out."
}

text ShadyRoom_Text_Gentleman_NatureCost {
    "A complete shift in Nature, is it?\n"
	"That will run you two units of credit.\p"
	"Do we have a deal?"
}

text ShadyRoom_Text_Gentleman_SameNature {
    "My friend, it already behaves like that.\n"
    "Don't play games with me. What do you really need?"
}

text ShadyRoom_Text_Gentleman_NatureChanged {
    "Pleasure doing business with you.\n"
    "Its mindset has been... optimized."
}

text ShadyRoom_Text_Gentleman_HiddenAbilityCost {
	"Ah, looking for the premium stock?\n"
	"Unlocking a Hidden Ability isn't cheap.\p"
	"That will run you four units of credit.\p"
	"Do we have a deal?"
}

text ShadyRoom_Text_Gentleman_AlreadyHiddenAbility {
    "My work is already done.\n"
    "This one's carrying the premium package.\p"
    "No sense charging you twice."
}

text ShadyRoom_Text_Gentleman_HiddenAbilityConfirm {
    "I can unlock {STR_VAR_1} for this one.\n"
	"Shall I proceed?"
}

text ShadyRoom_Text_Gentleman_HAApplied {
    "There. The latent potential has been\n"
	"unlocked. Keep this between us, eh?"
}

text ShadyRoom_Text_Gentleman_RestoreAbilityOffer {
    "Want to put things back the way\n"
    "nature intended?\p"
    "I can restore its standard Ability.\n"
    "No charge. Do we have a deal?"
}

text ShadyRoom_Text_Gentleman_AlreadyRegularAbility {
    "Looks to me like this one's already\n"
    "running the factory settings.\p"
    "Nothing for me to do."
}

text ShadyRoom_Text_Gentleman_RestoreAbilityConfirm {
    "I can restore {STR_VAR_1} for this one.\n"
    "Shall I proceed?"
}

text ShadyRoom_Text_Gentleman_AbilityRestored {
    "There. Back to the standard model.\n"
    "Sometimes less attention is the best disguise."
}

text ShadyRoom_Text_Gentleman_IVCost {
    "Ah, maxing out potential? Radical changes\n"
    "carry a steeper premium.\p"
    "That will cost two units of credit.\n"
    "Do we have a deal?"
}

text ShadyRoom_Text_Gentleman_IVAlreadyMax {
	"That stat is already at its peak.\n"
	"No point wasting credit on it."
}

text ShadyRoom_Text_Gentleman_IVConfirm {
    "I can push its {STR_VAR_1} to the\n"
    "absolute limit. Shall I proceed?"
}

text ShadyRoom_Text_Gentleman_IVMaxed {
	"Perfect. You won't find a cleaner\n"
	"modification job anywhere else."
}

text ShadyRoom_Text_Assistant_Greeting {
    "ASSISTANT: Please state your request.\n"
    "The Gentleman has approved my services.\p"
    "I will handle any procedures you require."
}

text ShadyRoom_Text_Assistant_Menu {
    "Available procedures?"
}

text ShadyRoom_Text_Assistant_StatusFlavor {
    "Status manipulation is a simple\n"
    "procedure when properly monitored.\p"
    "Shall we begin?"
}

text ShadyRoom_Text_Assistant_StatusCured {
    "Status condition removed.\n"
    "The subject has returned to normal."
}

text ShadyRoom_Text_Assistant_StatusInflicted {
    "Procedure complete.\n"
    "The requested condition has been applied."
}

text ShadyRoom_Text_Assistant_DamageFlavor {
    "I will apply controlled damage.\n"
    "Minor discomfort is to be expected.\p"
    "Try not to move."
}

text ShadyRoom_Text_Assistant_DamageApplied {
    "Procedure complete.\n"
    "The subject is within acceptable limits."
}

text ShadyRoom_Text_Merchant_Greeting {
    "Hey dude"
}

text ShadyRoom_Text_Merchant_Menu {
    "What would you like to purchase?\n"
    "You have {STR_VAR_3} credit(s)"
}

text ShadyRoom_Text_Merchant_PurchaseConfirm {
    "Would you like to buy\n"
    "{STR_VAR_2} for {STR_VAR_1} credit(s)?"
}

text ShadyRoom_Text_Merchant_PurchaseCommit {
    "Purchase confirmed!"
}

text ShadyRoom_Text_Merchant_InsufficientFunds {
    "You ain't got enough money, homeboy"
}
